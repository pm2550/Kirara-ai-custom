[32m2026-01-17 15:22:04.902[0m | [34m[1mDEBUG   [0m | [36mBlock.Code  [0m | [34m[1mExecuting code definition:
import re
from kirara_ai.im.message import IMMessage, TextMessage, EmojiMessage
from kirara_ai.im.sender import ChatSender

def execute(llm_text):
    llm_text = (llm_text or "").replace("<@llm>", "").replace("\r\n", "<break>").replace("\n", "<break>")
    messages = []

    segments = llm_text.split("<break>")

    for segment in segments:
        segment = segment.strip()
        if not segment:
            continue

        elements = []
        face_pattern = r'\[face:(\d+)\]'
        parts = re.split(face_pattern, segment)

        for i, part in enumerate(parts):
            if i % 2 == 0:
                text = part.strip()
                if text:
                    elements.append(TextMessage(text))
            else:
                elements.append(EmojiMessage(face_id=part))

        if elements:
            messages.append(
                IMMessage(
                    sender=ChatSender.get_bot_sender(),
                    message_elements=elements
                )
            )

    if not messages:
        messages = [
            IMMessage(
                sender=ChatSender.get_bot_sender(),
                message_elements=[TextMessage(llm_text.strip())]
            )
        ]

    return {
        "msgs": messages
    }

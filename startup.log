from kirara_ai.im.message import ImageMessage
import re

def execute(msg):
    image_urls = []
    # 优先从解析好的元素里拿
    if msg and getattr(msg, "message_elements", None):
        for element in msg.message_elements:
            if isinstance(element, ImageMessage):
                if element.url:
                    image_urls.append(element.url)
                elif element.path:
                    image_urls.append(element.path)
                elif element.media_id:
                    image_urls.append(f"media_id:{element.media_id}")
    # 兜底从 raw_message 里的 CQ 码或 message 数组解析 URL
    if msg:
        raw = getattr(msg, "raw_message", "")
        # OneBot 的 raw.message 里通常带有解析好的图片 URL
        raw_msg_list = None
        if isinstance(raw, dict):
            raw_msg_list = raw.get("message")
        else:
            raw_msg_list = getattr(raw, "message", None)
        if raw_msg_list:
            for item in raw_msg_list:
                if item.get("type") == "image":
                    url = item.get("data", {}).get("url") or item.get("data", {}).get("file")
                    if url:
                        url = str(url).replace("&amp;", "&")
                        if url not in image_urls:
                            image_urls.append(url)
        # raw 可能是 dict/对象，尽量转成字符串再搜
        try:
            raw_str = str(raw)
        except Exception:
            raw_str = ""
        # 搜 CQ:image 的 url 字段
        match = re.search(r"url=([^,\\]]+)", raw_str)
        if match:
            url = match.group(1).replace("&amp;", "&")
            if url not in image_urls:
                image_urls.append(url)

    user_text = getattr(msg, "content", "") or ""
    return {
        "image_urls": image_urls,
        "has_images": bool(image_urls),
        "user_text": user_text,
        "msg": msg,
    }

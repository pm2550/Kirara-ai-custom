def execute(image_urls, user_text, msg):
    from kirara_ai.im.message import IMMessage, TextMessage, ImageMessage
    
    # 1. 构造 safe_msg，保留已下载成功的图片(Valid ImageMessage)，剔除 broken 的
    safe_elements = []
    has_valid_images = False
    
    if msg and getattr(msg, "message_elements", None):
        for element in msg.message_elements:
            if isinstance(element, ImageMessage):
                # 检查是否是 fallback 的 url_only
                if str(element.media_id).startswith("url_only:"):
                    pass # Skip broken image
                else:
                    # 认为是有效图片（已下载或有path）
                    safe_elements.append(element)
                    has_valid_images = True
            else:
                safe_elements.append(element)
    
    if not safe_elements:
        # 如果没有元素，至少放入文本（避免 message 为空）
        safe_elements = [TextMessage(text=user_text or "")]
        
    safe_msg = IMMessage(
        sender=msg.sender,
        message_elements=safe_elements,
        raw_message=None
    )
    
    # 2. 如果有有效图片实体传给 LLM，直接请求识别
    if has_valid_images:
        prompt = "请提取图片中的文字；若无文字则简要描述主要内容。每张图片不超过50字。"
        return {
            "ocr_user_prompt": prompt,
            "user_text": user_text or "",
            "safe_msg": safe_msg,
        }
        
    # 3. 如果没有有效图片实体（比如下载失败被过滤了），则尝试 fallback 到 URL 方式
    # 只有非腾讯域名的 public URL 才能被 Gemini 直接通过 Prompt 访问
    image_urls = image_urls or []
    accessible_urls = []
    for url in image_urls:
        if url.startswith("url_only:") or url.startswith("media_id:"):
            continue
        if "gchat.qpic.cn" in url or "multimedia.nt.qq.com" in url:
            continue
        accessible_urls.append(url)
    
    if not accessible_urls:
        # 所有图片都无法访问
        return {
            "ocr_user_prompt": "(图片内容无法访问，请根据上下文回复)",
            "user_text": (user_text or "") + f"\n[用户发送了{len(image_urls)}张图片]",
            "safe_msg": safe_msg,
        }

    lines = [f"{idx+1}. {url}" for idx, url in enumerate(accessible_urls[:4])]
    prompt = (
      "请阅读以下图片（URL可访问），提取图片文字；若无文字则简要描述主要内容。"
      "每张图片不超过50字，按序号逐条输出，最多4张。\n"
      "图片列表:\n" + "\n".join(lines)
    )

    return {
        "ocr_user_prompt": prompt,
        "user_text": user_text or "",
        "safe_msg": safe_msg,
    }

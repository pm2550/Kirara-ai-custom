from kirara_ai.im.message import IMMessage, TextMessage

def execute(user_text, ocr_text, has_images, orig_msg=None):
    user_text = user_text or ""
    ocr_text = (ocr_text or "").strip()

    if has_images:
        if ocr_text:
            merged = f"{user_text}\n[图片OCR]: {ocr_text}".strip()
        else:
            merged = f"{user_text}\n[图片OCR]: (未识别到文字)".strip()
    else:
        merged = user_text

    # Build new IMMessage preserving sender; do not carry images to text model
    sender = getattr(orig_msg, "sender", None) if orig_msg is not None else None
    final_msg = IMMessage(sender=sender, message_elements=[TextMessage(merged)])

    return {
        "final_user_msg": final_msg
    }
